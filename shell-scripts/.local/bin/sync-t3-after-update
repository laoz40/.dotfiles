#!/usr/bin/env bash
# Sync boot service and launchers to the T3 Code AppImage on disk.
# Update T3 from the in-app UI first, then run this script.
set -euo pipefail

T3="$HOME/.local/bin/t3"
APPS_DIR="${APPS_DIR:-$HOME/Applications}"
TAILSCALE_IP="${TAILSCALE_IP:-}"
T3_PORT="${T3CODE_PORT:-3773}"
UNIT="$HOME/.config/systemd/user/t3code.service"
WRAPPER="$HOME/.local/bin/t3code"
T3_HOME="${T3CODE_HOME:-$HOME/.t3}"

usage() {
  cat <<'EOF'
Usage: sync-t3-after-update [--launchers-only] [version | path-to-AppImage]

After updating T3 from the in-app UI, run this to align:
  t3code.service (Tailscale), desktop entries, and the
  t3code command wrapper, using the app-installed ~/.local/bin/t3 CLI.

Launchers are repaired before checking the CLI. Use --launchers-only to repair
shortcuts without installing the CLI or restarting the service.
Stale T3-generated CLI launchers are repointed to the selected AppImage and
validated before replacement. Open the desktop app to install a missing CLI.
Uses this device's Tailscale IPv4 address unless TAILSCALE_IP is set.

With no argument, uses the newest T3-Code-*-x86_64.AppImage in ~/Applications
(by modification time).
EOF
}

appimage_from_version() {
  local ver="$1"
  local path="$APPS_DIR/T3-Code-${ver}-x86_64.AppImage"
  if [[ -f "$path" ]]; then
    echo "$path"
    return 0
  fi
  echo "sync-t3-after-update: no AppImage at $path" >&2
  return 1
}

version_from_appimage() {
  local base
  base=$(basename "$1")
  base=${base#T3-Code-}
  base=${base%-x86_64.AppImage}
  printf '%s' "$base"
}

resolve_appimage() {
  local arg="${1:-}"
  if [[ -z "$arg" ]]; then
    local latest
    latest=$(ls -t "$APPS_DIR"/T3-Code-*-x86_64.AppImage 2>/dev/null | head -1 || true)
    if [[ -z "$latest" || ! -f "$latest" ]]; then
      echo "sync-t3-after-update: no T3-Code AppImage in $APPS_DIR" >&2
      return 1
    fi
    echo "$latest"
    return 0
  fi
  if [[ -f "$arg" ]]; then
    echo "$arg"
    return 0
  fi
  appimage_from_version "$arg"
}

write_unit() {
  mkdir -p "$(dirname "$UNIT")" "$T3_HOME/userdata/logs"
  cat >"$UNIT" <<EOF
[Unit]
Description=T3 Code server
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h
Environment=T3CODE_HOME=$T3_HOME
Environment=T3_BOOT_SERVICE_UNIT=t3code.service
Environment=T3CODE_HOST=$TAILSCALE_IP
Environment=T3CODE_PORT=$T3_PORT
Environment=TAILSCALE_WAIT_HOST=$TAILSCALE_IP
ExecStart=%h/.local/bin/wait-for-tailscale-exec "$T3" serve --host "$TAILSCALE_IP" --port "$T3_PORT" --base-dir "$T3_HOME"
# The bundled CLI is a shell wrapper; its server child must receive SIGTERM too.
KillMode=control-group
OOMPolicy=continue
Restart=always
RestartSec=5
StandardOutput=append:$T3_HOME/userdata/logs/boot-service.log
StandardError=append:$T3_HOME/userdata/logs/boot-service.log

[Install]
WantedBy=default.target
EOF
}

update_desktop_exec() {
  local file="$1"
  local appimage="$2"
  [[ -f "$file" ]] || return 0
  # Replace only the AppImage path, preserving flags and URL placeholders.
  sed -i "s|^Exec=.*\\.AppImage\"\\{0,1\\}|Exec=\"$HOME/.local/bin/t3code-desktop-launch\" \"$appimage\"|" "$file"
  if ! rg -q '^Exec=.*--password-store=' "$file"; then
    sed -i '/^Exec=/s|\.AppImage"|.AppImage" --password-store=gnome-libsecret|' "$file"
  fi
}

update_launchers() {
  local appimage="$1" version="$2"
  local apps="$HOME/.local/share/applications"
  update_desktop_exec "$apps/com.t3tools.T3Code.desktop" "$appimage"
  update_desktop_exec "$apps/t3code.desktop" "$appimage"
  update_desktop_exec "$apps/t3code-url-handler.desktop" "$appimage"
  if [[ -f "$apps/t3code.desktop" ]]; then
    sed -i "s|^X-AppImage-Version=.*|X-AppImage-Version=$version|" "$apps/t3code.desktop"
  fi

  echo "Writing $WRAPPER..."
  mkdir -p "$(dirname "$WRAPPER")"
  cat >"$WRAPPER" <<EOF
#!/usr/bin/env bash
exec "$HOME/.local/bin/t3code-desktop-launch" "$appimage" --no-sandbox --password-store=gnome-libsecret "\$@"
EOF
  chmod +x "$WRAPPER"
}

cli_version() {
  "$1" --version | awk '{sub(/^v/, "", $2); print $2}'
}

refresh_cli() {
  local appimage="$1" version="$2"
  local target candidate quoted_app line candidate_ver
  target=$(readlink -f "$T3")
  if ! rg -Fxq "# Written by T3 Code: runs the desktop app's bundled t3 CLI." "$target" ||
    [[ $(rg -c "^app='.*\\.AppImage'$" "$target") != 1 ]]; then
    echo "sync-t3-after-update: unrecognized CLI launcher at $target; open the selected AppImage to refresh it" >&2
    return 1
  fi

  candidate=$(mktemp "${target}.XXXXXX")
  # The generated launcher is POSIX sh, so quote apostrophes without Bash syntax.
  quoted_app="'${appimage//\'/\'\\\'\'}'"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == app=* ]]; then
      printf 'app=%s\n' "$quoted_app"
    else
      printf '%s\n' "$line"
    fi
  done <"$target" >"$candidate"
  chmod --reference="$target" "$candidate"

  echo "Validating CLI against $appimage..."
  if ! candidate_ver=$(cli_version "$candidate"); then
    rm -f "$candidate"
    echo "sync-t3-after-update: selected AppImage CLI failed; existing CLI launcher was kept" >&2
    return 1
  fi
  if [[ "$candidate_ver" != "$version" ]]; then
    rm -f "$candidate"
    echo "sync-t3-after-update: selected AppImage CLI is $candidate_ver, expected $version; existing CLI launcher was kept" >&2
    return 1
  fi
  mv -f "$candidate" "$target"
  echo "Updated $target to $version."
}

main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
  fi

  local launchers_only=false
  if [[ "${1:-}" == "--launchers-only" ]]; then
    launchers_only=true
    shift
  fi

  local appimage version cli_ver
  appimage=$(resolve_appimage "${1:-}")
  appimage=$(realpath "$appimage")
  version=$(version_from_appimage "$appimage")

  echo "AppImage: $appimage"
  echo "Version:  $version"

  update_launchers "$appimage" "$version"
  if [[ "$launchers_only" == true ]]; then
    echo "Done. Launchers are on $version."
    return 0
  fi

  if [[ ! -x "$T3" ]]; then
    echo "sync-t3-after-update: launchers repaired; missing $T3; open T3 Code and install the CLI, then retry" >&2
    exit 1
  fi

  cli_ver=$(cli_version "$T3" 2>/dev/null) || cli_ver=""
  if [[ "$cli_ver" != "$version" ]]; then
    refresh_cli "$appimage" "$version"
  fi

  if [[ -z "$TAILSCALE_IP" ]]; then
    if ! TAILSCALE_IP=$(tailscale ip -4); then
      echo "sync-t3-after-update: could not detect Tailscale IPv4; connect Tailscale or set TAILSCALE_IP" >&2
      exit 1
    fi
    if [[ -z "$TAILSCALE_IP" ]]; then
      echo "sync-t3-after-update: no Tailscale IPv4; connect Tailscale or set TAILSCALE_IP" >&2
      exit 1
    fi
  fi

  echo "Writing $UNIT..."
  write_unit

  echo "Restarting t3code.service..."
  systemctl --user daemon-reload
  systemctl --user restart t3code.service

  cli_ver=$(cli_version "$T3")
  if [[ "$cli_ver" != "$version" ]]; then
    echo "sync-t3-after-update: version mismatch (cli=$cli_ver, appimage=$version)" >&2
    exit 1
  fi

  echo "Done. CLI, service, and launchers are on $version."
}

main "$@"
