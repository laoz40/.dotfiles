{
  "lastChangelogVersion": "0.84.3",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-terra",
  "packages": [
    "https://github.com/mateusdcc/pi-gpt-search",
    "npm:pi-rewind",
    "npm:pi-clarify",
    "npm:@plannotator/pi-extension",
    "npm:pi-cursor-sdk"
  ],
