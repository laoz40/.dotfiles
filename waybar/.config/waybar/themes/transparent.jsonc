{
  "layer": "bottom",
  "position": "top",
  "height": 0,
  "spacing": 0,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 10,
  "margin-right": 10,
  "exclusive": true,
  "gtk-layer-shell": true,
  "passthrough": false,
  "fixed-center": true,
  "modules-left": [
    "hyprland/workspaces",
    "custom/workspace-windows",
    // "hyprland/window",
    "mpris",
    "custom/timer",
  ],
  "modules-center": [
    "clock#simpleclock",
    "clock",
  ],
  "modules-right": [
    "custom/privacy-dots",
    "network",
    "bluetooth",
    "pulseaudio",
    "custom/microphone",
    "cpu",
    "custom/ram-alert",
    "battery",
    "idle_inhibitor",
    "custom/power",
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{name}",
    "all-outputs": true,
    "disable-scroll": false,
    "active-only": false,
    "show-special": true,
    "special-visible-only": true,
  },
  "custom/workspace-windows": {
    "exec": "~/.local/bin/waybar_workspace_windows.sh",
    "return-type": "json",
    "interval": 1,
    "format": "{text}",
    "tooltip": true,
    "escape": false,
    "markup": "pango",
    "max-length": 120,
  },
  "custom/timer": {
    "exec": "~/.local/bin/rofi_waybar_timer/rofi_waybar_timer.sh waybar_fetch",
    "on-click": "~/.local/bin/rofi_waybar_timer/rofi_waybar_timer.sh waybar_toggle",
    "return-type": "json",
    "interval": 1,
    "format": "{icon}{text}",
    "format-icons": {
      "active": "<span color='#efeff1'> </span>",
      "paused": "<span color='#efeff1'>󰏤 </span>",
    },
  },
  "hyprland/window": {
    "format": "{title}",
    "icon": true,
    "icon-size": 12,
  },
  "mpris": {
    "player": "spotify",
    "dynamic-order": ["artist", "title"],
    "format": "<span color='#efeff1'>{player_icon}</span> {dynamic}",
    "format-paused": "<span color='#efeff1'>{status_icon}</span> {dynamic}",
    "max-length": 50,
    "status-icons": {
      "paused": "",
    },
    "player-icons": {
      "default": "",
    },
  },

  "custom/privacy-dots": {
    "exec": "PRIVACY_DOT_COLOR=#efeff1 ~/.local/bin/privacy_dots.sh",
    "return-type": "json",
    "interval": 3,
    "format": "{text}",
    "tooltip": true,
    "escape": false,
    "markup": "pango",
  },
  "network": {
    "format-wifi": "<span color='#efeff1'>󰤨</span> {essid}",
    "format-ethernet": "<span color='#efeff1'></span> Wired",
    "tooltip-format": "<span color='#efeff1'>󰅧 </span>{bandwidthUpBytes}<span color='#efeff1'> 󰅢 </span>{bandwidthDownBytes} <span color='#efeff1'>󰤨 </span>{signalStrength}%",
    "format-linked": "<span color='#efeff1'>󱘖 </span> {ifname} (No IP)",
    "format-disconnected": "<span color='#e06c75'> </span> Disconnected",
    "interval": 1,
    "on-click": "rofi-network-manager",
  },
  "bluetooth": {
    "format": "<span color='#efeff1'>󰂲</span>",
    "format-on": "<span color='#efeff1'>{icon}</span>",
    "format-off": "<span color='#efeff1'>{icon}</span>",
    "format-connected": "<span color='#efeff1'></span> {device_alias}",
    "format-connected-battery": "<span color='#efeff1'></span> {device_alias}",
    "format-icons": {
      "on": "󰂯",
      "off": "󰂲",
      "connected": "󰂱",
    },
    "on-click": "blueman-manager",
    "tooltip-format": "{num_connections} connected",
    "tooltip-format-connected": "{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
  },
  "custom/microphone": {
    "format": "{text}",
    "return-type": "json",
    "exec": "~/.local/bin/toggle_mic.sh waybar_fetch",
    "on-click": "~/.local/bin/toggle_mic.sh",
    "interval": 1,
    "tooltip": true,
  },
  "pulseaudio": {
    "format": "<span color='#efeff1'>{icon}</span>{volume}%",
    "format-muted": "<span color='#efeff1'>  </span>Muted",
    "format-icons": {
      "headphone": " ",
      "default": [" ", " ", " "],
    },
    "on-click": "pavucontrol",
  },
  "cpu": {
    "format": "<span color='#efeff1'></span> {usage}%",
    "tooltip": true,
    "interval": 10,
    "on-click": "ghostty --class=com.ghostty.float -e btop",
  },
  "custom/ram-alert": {
    "exec": "RAM_ICON_COLOR=#efeff1 ~/.local/bin/ram-alert.sh waybar",
    "return-type": "json",
    "interval": 10,
    "format": "{text}",
    "tooltip": true,
    "escape": false,
    "on-click": "ghostty --class=com.ghostty.float -e btop",
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "<span color='#efeff1'>{icon}</span> {capacity}%",
    "format-time": "{H}h {M}min",
    "format-icons": ["󰂎", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "format-charging": "<span color='#efeff1'>󰉁 {capacity}%</span>",
    "tooltip-format": "<b>Discharging</b>: {time}",
    "tooltip-format-charging": "<b>Charging</b>: {time}",
    "events": {
      "on-discharging-warning": "notify-send 'Battery Low' -u critical -i 'battery-020' -r 1525",
      "on-discharging-critical": "notify-send 'PLUG IN A CHARGER IM GONNA DIE' -u critical -i 'battery-010' -r 1525",
      "on-charging-100": "notify-send 'Battery Full (100%)' -i 'battery-100-charged'",
    },
    "interval": 10,
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰖨",
      "deactivated": "󰤄",
    },
    "tooltip-format-activated": "Idle inhibitor: Activated",
    "tooltip-format-deactivated": "Idle inhibitor: Deactivated",
  },
  "clock#simpleclock": {
    "tooltip": false,
    "format": "<span color='#efeff1'> </span>{:%I:%M%p}",
    "format-alt": "<span color='#efeff1'> </span>{:%I:%M:%S}",
    "interval": 1,
  },
  "clock": {
    "format": "<span color='#efeff1'> </span>{:L%a %d}",
    "calendar": {
      "format": {
        "days": "<span weight='normal'>{}</span>",
        "months": "<span color='#efeff1'><b>{}</b></span>",
        "today": "<span color='#efeff1' weight='700'><u>{}</u></span>",
        "weekdays": "<span color='#efeff1'><b>{}</b></span>",
        "weeks": "<span color='#efeff1'><b>W{}</b></span>",
      },
      "mode": "month",
      "mode-mon-col": 1,
      "on-scroll": 1,
    },
    "tooltip-format": "<span color='#efeff1' font='JetBrains Mono 16'><tt><small>{calendar}</small></tt></span>",
  },
  "custom/power": {
    "tooltip": false,
    "on-click": "bash ~/.local/bin/rofi_power_menu.sh",
    "format": "<span color='#efeff1'>⏻</span>",
  },
}
